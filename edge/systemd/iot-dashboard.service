[Unit]
Description=Smart Room Guardian - web dashboard
After=network.target mariadb.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/IoT-Programming/edge
ExecStart=/home/pi/iot-venv/bin/python3 /home/pi/IoT-Programming/edge/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
